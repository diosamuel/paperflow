# PaperFlow — central configuration. Copy to .env and adjust:
#   cp .env.example .env

# --- FastAPI IoT service (api/) ---
HOST=0.0.0.0
PORT=8000

# MQTT bridge (must match mqtt/raspi.py on the Raspberry Pi)
MQTT_HOST=broker.mqtt.cool
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=paperflow-api
MQTT_SENSOR_TOPIC=paperflow/sensor
MQTT_BUTTONS_TOPIC=paperflow/sensor/buttons
MQTT_ACTUATOR_PREFIX=paperflow/actuator
MQTT_LED_COLORS=red,yellow,green
MQTT_STALE_AFTER_SECONDS=15

# --- Airflow API ---
# api/ triggers AIRFLOW_DAG_ID (auto_generate_dag) after POST /save, and triggers
# the most recently created DAG whenever the breadboard button is pressed.
AIRFLOW_API_URL=http://localhost:8080
AIRFLOW_API_USERNAME=admin
AIRFLOW_API_PASSWORD=admin
AIRFLOW_DAG_ID=auto_generate_dag
# Absolute path override for the folder the button press scans for that DAG.
# Defaults to <repo>/airflow/dags.
# AIRFLOW_DAGS_DIR=

# --- PaperFlow service (DAGs + builder UI) ---
PAPERFLOW_API_BASE=http://localhost:8000
PAPERFLOW_LLM_CONN_ID=pydanticai_default
PAPERFLOW_LLM_MODEL=

# Same service as PAPERFLOW_API_BASE above; Vite only exposes VITE_* to the UI.
VITE_API_BASE=http://localhost:8000
